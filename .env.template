# ==============================================
# 🚀 CODE ROOM API - AUTHENTICATION BACKEND
# ==============================================

# Server Configuration
PORT=3000

# ==============================================
# 🗄️ DATABASE CONFIGURATION (Prisma)
# ==============================================
# Prisma supports native connection strings for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://username:password@localhost:3306/database_name"
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password  
MYSQL_DB=your_database_name

# ==============================================
# 🔐 JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ==============================================
# ☁️ MINIO S3 STORAGE SERVICE
# ==============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=code-room-storage
MINIO_USE_SSL=false

# ==============================================
# 🐍 PYTHON SCRAPER MICROSERVICE
# ==============================================
# URL del microservicio Python containerizado
PYTHON_SERVICE_URL=http://localhost:8001